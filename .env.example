# Legacy combined reference only. Copy each app's .env.example instead.
# The root .env is no longer loaded by application commands.
# Public application URL
# npm run dev listens on all interfaces: localhost and your machine's LAN IP.
# Frontend invitations: port 3000. Backend API and /admin: port 3001.
# Auth redirects stay on the address used to log in; sessions are per hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Each application's own Next config sets APP_ROLE automatically.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Frontend server-to-server connection (optional in production).
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# Production: deploy frontend/ and backend/ separately from this repository.
# Set both URLs to distinct HTTPS origins on both deployments before building.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Do not expose this with NEXT_PUBLIC_ or import it in client code.
# SUPABASE_SERVICE_ROLE_KEY=server-only-if-a-protected-bootstrap-job-needs-it
NEXT_PUBLIC_WEDDING_SLUG=binh-minh-ninh-hue
WISH_RATE_LIMIT_SECRET=replace-with-a-random-server-secret
# Server-only: 32 random bytes encoded as 64 hexadecimal characters.
# Keep this stable and backed up; changing it prevents reopening previously saved links.
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
INVITATION_LINK_ENCRYPTION_KEY=
