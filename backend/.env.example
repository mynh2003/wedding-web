# Development. Production: replace BOTH origins with distinct HTTPS hosts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_WEDDING_SLUG=binh-minh-ninh-hue
WISH_RATE_LIMIT_SECRET=replace-with-a-random-server-secret
# Backend only: required in production for durable throttling and public writes.
# Apply 202610220001_backend_abuse_controls.sql after configuring this key.
# Never put this key in frontend or a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Vercel supplies a trusted IP header automatically. Other production proxies
# must overwrite this header and block access that bypasses the proxy.
# TRUSTED_PROXY_IP_HEADER=x-real-ip
# 32 random bytes, hex encoded. Keep stable and back up outside the repository.
INVITATION_LINK_ENCRYPTION_KEY=
